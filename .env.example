# Neon Postgres connection string (pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Better Auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Seed admin (used once by scripts/seed-admin.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# Cloudflare R2 (images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.example.com

# Public site URL (used for RSS/sitemap/OG absolute links)
SITE_URL=http://localhost:3000

# giscus comments (optional — leave blank to disable). From giscus.app
GISCUS_REPO=
GISCUS_REPO_ID=
GISCUS_CATEGORY=
GISCUS_CATEGORY_ID=

# Privacy analytics (optional — Plausible-compatible). Leave blank to disable
PLAUSIBLE_DOMAIN=
PLAUSIBLE_SRC=https://plausible.io/js/script.js
